---Query to process and clean fact_customer_journey
SELECT 
	JourneyID, --Selects the unique indentifier of each journey to ensure tracebility
	CustomerID, --Selects the unique indentifier of each customer to link jounry to specific cus
	ProductID, --Selects the unique indentifier of each product to anlyse custermer interactions with different products
	VisitDate, --Select the data ofthe customer's visiit to help understand the timeline of cutomer interactions
	Action,-- Uses the uppercased taken by the customer  
	COALESCE(Duration,avg_duration) AS Duration --Replaces the missing durations with avrage duration
FROM
	(
	--Subquery to process and clean data
		SELECT
			JourneyID, --Selects the unique indentifier of each journey
			CustomerID, --Selects the unique indentifier of each customer
			ProductID, --Selects the unique indentifier of each product
			VisitDate, --Select the data ofthe customer's visit(which helps us to determin a timeline FOR custermer interactions)
			UPPER(Stage) AS Stage,--Select the stage of the Customer journey
			Action,-- Selects the action taken by the customer (View,Click,Purchase)
			Duration,--Selects the duration of the action or interaction
			AVG(Duration) OVER (PARTITION BY VisitDate) as avg_duration,
			--use ROW_NUMBER TO assign a unique row number to each recored within the partiton defined below
			ROW_NUMBER() OVER(
				--PARTITION BY groups the rows based on the specified coloumns should be unique  )
				PARTITION BY CustomerID,ProductID,VisitDate,Stage,Action
				--ORDER BY define the to order the row  withing each partition
				ORDER BY JourneyID
			) AS row_num --Creates a new colunm called "row_num" thaty numbers each row within it's partition
		FROM 
			dbo.customer_journey
	) AS subquery 
WHERE
	row_num = 1;
