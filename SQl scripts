--Query to clean white spaces in fact_customer_reviews ReviewText column 
SELECT 
	ReviewID,--Selects the unique indentifier of each review
	CustomerID,--Selects the unique indentifier of each customer
	ProductID,--Selects the unique indentifier of each product
	ReviewDate,--Selects the date of each review
	Rating,--Selects the rating of each review
	--Cleaning up ReviewText by replacing double spaces with single space to ensure thetext is more readble and standandized 
	REPLACE (ReviewText,'  ', ' ') AS ReviewText
FROM 
	dbo.customer_reviews;
