-- Querying products to categirise them based on their price 
SELECT 
	ProductID,--Selects the unique indentifier of each product
	ProductName,--Selects the name of each product
	Price,--Selects the price of each product

	--Catagorying the products into price categories: Low, Medium, or High
	CASE 
		WHEN Price < 100 THEN 'Low' -- If the price is lower then 100 ,it will be categrised as Low 
		WHEN Price BETWEEN 100 AND 300 THEN 'Medium' -- If the price is between 100 and 300  ,it will be categrised as Medium 
		ELSE 'High'-- If the price is higher then 300 ,is will be categrised as High 
	END AS PriceCategory -- The name odf the new column as PriceCategory

FROM 
   dbo.products;

